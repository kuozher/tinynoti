<Window x:Class="TinyNoti.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="394"
        MaxHeight="{Binding MaxAvailableHeight}"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#E6F8FAFC" />
            <Setter Property="BorderBrush" Value="#CCD8E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Background" Value="#88F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#66D8E0EC" />
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTextButton" TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#B8F8FAFC" />
            <Setter Property="BorderBrush" Value="#88D8E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#3B6B9A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D8E0EC" />
                                <Setter Property="Foreground" Value="#2563EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#E2E8F0" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OverlayRoot" Width="384">
        <Grid.RenderTransform>
            <TranslateTransform />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderActions"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="{Binding HeaderHorizontalAlignment}"
                    Margin="{Binding HeaderMargin}"
                    Visibility="{Binding IsOverlayChromeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button x:Name="RemoveAllButton"
                    Style="{StaticResource HeaderTextButton}"
                    Content="Clear all"
                    ToolTip="Clear all notifications"
                    Click="ClearAll_Click" />
            <Button x:Name="HideForNowButton"
                    Style="{StaticResource RoundIconButton}"
                    Margin="6,0,0,0"
                    ToolTip="Hide for now"
                    Click="HideOverlay_Click">
                <Path x:Name="HideArrow"
                      Width="7"
                      Height="12"
                      IsHitTestVisible="False"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Uniform"
                      Data="M 1 1 L 6 6 L 1 11" />
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Border x:Name="GlassPanel"
                    BorderBrush="#4CF8FAFC"
                    BorderThickness="0,1,1,1"
                    CornerRadius="{Binding GlassCornerRadius}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00F8FAFC" Offset="0" />
                        <GradientStop Color="#28F8FAFC" Offset="0.08" />
                        <GradientStop Color="#52F8FAFC" Offset="0.22" />
                        <GradientStop Color="#5EF8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer x:Name="CardsScrollViewer"
                          VerticalAlignment="Top"
                          MaxHeight="{Binding MaxListHeight}"
                          Margin="0,10,0,10"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalFirst"
                          CanContentScroll="False">
                <Grid VerticalAlignment="Top" MinHeight="{Binding ContentMinHeight}">
                    <ItemsControl x:Name="CardsItems"
                                  ItemsSource="{Binding Cards}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="10" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1"
                                                                 Duration="0:0:0.24">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0"
                                                                 Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="360"
                                        MaxHeight="260"
                                        Margin="12,0,12,8"
                                        Padding="16,12,16,12"
                                        Background="#FFFFFF"
                                        BorderBrush="#D8E0EC"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Cursor="Hand"
                                        ToolTip="Click to open link / application"
                                        RenderTransformOrigin="0.5,0.5"
                                        MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Row 0: App Icon + App Name + Time + Dismiss Button -->
                                            <RowDefinition Height="Auto" />
                                            <!-- Row 1: Content Area (Avatar + Title/Body/Image) -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Header -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- App Icon (Option A: pure transparent, 32x32) -->
                                                <Image Source="{Binding AppIconUri}"
                                                       Width="32"
                                                       Height="32"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding AppIconUri, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <!-- App Name -->
                                                <TextBlock Text="{Binding AppName}"
                                                           Foreground="#2563EB"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <!-- Time -->
                                                <TextBlock Text="{Binding TimeText}"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Dismiss Button -->
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource RoundIconButton}"
                                                    Click="Dismiss_Click"
                                                    ToolTip="Dismiss notification">
                                                <Path Width="10"
                                                      Height="10"
                                                      IsHitTestVisible="False"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="M 1 1 L 9 9 M 9 1 L 1 9" />
                                            </Button>
                                        </Grid>

                                        <!-- Row 1: Content Area (Avatar on Left, Title + Body + Image on Right) -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Circular Avatar (44x44, radius 22, clipped to circle) -->
                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="#E2E8F0"
                                                    Margin="0,1,12,0"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding AvatarUri, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Border.Clip>
                                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                                                </Border.Clip>
                                                <Image Source="{Binding AvatarUri}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Right Column: Title + Body + Image -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="#0F172A"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Body (2 lines preview if HasImage, else up to 90px) -->
                                                <TextBlock Text="{Binding Body}"
                                                           Foreground="#334155"
                                                           FontSize="12"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           LineHeight="18">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="MaxHeight" Value="90" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                    <Setter Property="MaxHeight" Value="36" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Content Image (Width ~1/2 card, bottom gradient fade) -->
                                                <Border Width="180"
                                                        Height="105"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        CornerRadius="8"
                                                        Background="#EEF2F7"
                                                        Visibility="{Binding ImageUri, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Border.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF000000" Offset="0.0" />
                                                            <GradientStop Color="#FF000000" Offset="0.7" />
                                                            <GradientStop Color="#00000000" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.OpacityMask>
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,180,105" RadiusX="8" RadiusY="8" />
                                                    </Border.Clip>
                                                    <Image Source="{Binding ImageUri}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Top"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="360"
                            MinHeight="112"
                            Margin="12,0,12,0"
                            Padding="20"
                            Background="#F8FAFC"
                            BorderBrush="#D8E0EC"
                            BorderThickness="1"
                            CornerRadius="11"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding EmptyStateVisibility}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="No recent notifications"
                                       Foreground="#334155"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="New notifications will appear here when they arrive."
                                       Foreground="#64748B"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Rectangle x:Name="BottomFade"
                       Height="92"
                       VerticalAlignment="Bottom"
                       IsHitTestVisible="False"
                       RadiusX="0"
                       RadiusY="0"
                       Visibility="{Binding BottomFadeVisibility}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F8FAFC" Offset="0" />
                        <GradientStop Color="#A8F8FAFC" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
    </Grid>
</Window>
