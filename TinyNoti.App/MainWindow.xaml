<Window x:Class="TinyNoti.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TinyNoti.App"
        mc:Ignorable="d"
        Title="TinyNoti   v1.0.0"
        Width="680"
        Height="760"
        MinWidth="680"
        MaxWidth="960"
        MinHeight="760"
        MaxHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, sans-serif"
        FontSize="13"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8" />
                    <Setter Property="BorderBrush" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Subtle Button -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FECACA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nav Tab RadioButton -->
        <Style x:Key="NavTabItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="NavTabs" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch for CheckBox -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22">
                            <Border x:Name="Track"
                                    Width="40"
                                    Height="22"
                                    CornerRadius="11"
                                    Background="#CBD5E1"
                                    BorderBrush="Transparent"
                                    BorderThickness="1" />
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#FFFFFF"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Direction="270" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Height="36"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M0,0 L4,4 L8,0"
                          Stroke="#64748B"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#94A3B8" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#0F172A" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}"
                                            Margin="2,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                            <Setter Property="Foreground" Value="#2563EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Height="{TemplateBinding Height}">
                            <ToggleButton x:Name="ToggleButton"
                                          Height="{TemplateBinding Height}"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,4,0,4">
                                    <Border x:Name="DropDownBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Direction="270" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="56" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Rounded TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D8E0EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Anchor Selector Item -->
        <Style x:Key="AnchorSelectorItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Padding="10,9"
                                Background="#F8FAFC"
                                BorderBrush="#D8E0EC"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar Navigation -->
        <Border Style="{StaticResource PanelCard}" Padding="16,18">
            <DockPanel LastChildFill="True">

                <!-- Header + Status + Access Button (Top) -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TinyNoti" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Notification mirror overlay"
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" />

                    <!-- Status Box -->
                    <Border Margin="0,16,0,0"
                            Padding="12,9"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{Binding AccessStatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding AccessStatusText, StringFormat=Notification access: {0}}"
                                       Foreground="#0F172A"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Mirroring Warning Text if paused -->
                    <TextBlock Text="{Binding MirroringStatusText}"
                               Foreground="#B45309"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="2,6,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMirroringStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Request Access Button -->
                    <Button Content="Request access"
                            Style="{StaticResource PrimaryButton}"
                            Click="RequestAccess_Click"
                            Margin="0,10,0,16" />

                    <Separator Background="#E2E8F0" Margin="0,0,0,14" />
                </StackPanel>

                <!-- Bottom Collapsible Settings Section (formerly Runtime) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Separator Background="#E2E8F0" Margin="0,14,0,12" />

                    <!-- Settings Header (Click to expand/collapse) -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="2,4"
                            Cursor="Hand"
                            Click="ToggleSettings_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Gear Icon -->
                                        <Path Width="16" Height="16"
                                              Stroke="#0F172A"
                                              StrokeThickness="1.2"
                                              Data="M7.5,1.5 L8.5,1.5 L8.9,3.1 A5,5 0 0,1 10.3,3.9 L11.8,3.2 L12.5,4.1 L11.8,5.5 A5,5 0 0,1 12.4,6.9 L14,7.4 L14,8.6 L12.4,9.1 A5,5 0 0,1 11.8,10.5 L12.5,11.9 L11.8,12.8 L10.3,12.1 A5,5 0 0,1 8.9,12.9 L8.5,14.5 L7.5,14.5 L7.1,12.9 A5,5 0 0,1 5.7,12.1 L4.2,12.8 L3.5,11.9 L4.2,10.5 A5,5 0 0,1 3.6,9.1 L2,8.6 L2,7.4 L3.6,6.9 A5,5 0 0,1 4.2,5.5 L3.5,4.1 L4.2,3.2 L5.7,3.9 A5,5 0 0,1 7.1,3.1 Z M8,6 A2,2 0 1,0 8,10 A2,2 0 0,0 8,6 Z"
                                              VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Settings"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#0F172A"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center" />

                                        <!-- Chevron Arrow (Upward '^' when collapsed, rotates 180° downward 'v' when expanded) -->
                                        <Path x:Name="Chevron"
                                              Grid.Column="2"
                                              Width="10" Height="6"
                                              Stroke="#64748B"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M1,5 L5,1 L9,5"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="180"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="0"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Collapsible Settings Options (Smooth Drawer Transition) -->
                    <Border ClipToBounds="True" Margin="2,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="MaxHeight" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsExpanded}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     To="130"
                                                                     Duration="0:0:0.24">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1"
                                                                     Duration="0:0:0.20">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                     To="0"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Margin="0,12,0,0">

                            <!-- Pause Mirroring Toggle -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Pause Icon -->
                                    <Path Width="14" Height="14"
                                          Fill="#334155"
                                          Data="M3,2 L5.5,2 L5.5,12 L3,12 Z M8.5,2 L11,2 L11,12 L8.5,12 Z"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Pause mirroring"
                                               FontSize="13"
                                               Foreground="#334155"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          IsChecked="{Binding Settings.IsPaused}" />
                            </Grid>

                            <!-- Start with Windows Toggle -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Monitor Icon -->
                                    <Path Width="15" Height="14"
                                          Stroke="#334155"
                                          StrokeThickness="1.2"
                                          Data="M1.5,2.5 L13.5,2.5 C14,2.5 14.5,3 14.5,3.5 L14.5,9.5 C14.5,10 14,10.5 13.5,10.5 L1.5,10.5 C1,10.5 0.5,10 0.5,9.5 L0.5,3.5 C0.5,3 1,2.5 1.5,2.5 Z M4.5,13.5 L10.5,13.5 M7.5,10.5 L7.5,13.5"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Start with windows"
                                               FontSize="13"
                                               Foreground="#334155"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource ModernToggleSwitch}"
                                          IsChecked="{Binding Settings.StartWithWindows}" />
                            </Grid>

                            <TextBlock Text="Changes save automatically."
                                       Style="{StaticResource CaptionText}"
                                       FontSize="11"
                                       Margin="2,2,0,0" />

                            <!-- Operation Status Text -->
                            <TextBlock Text="{Binding OperationStatusText}"
                                       Margin="2,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOperationStatus}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Tabs (Center) -->
                <StackPanel VerticalAlignment="Top">

                    <!-- Tab 1: Recent Notifications -->
                    <RadioButton Style="{StaticResource NavTabItem}"
                                 IsChecked="{Binding IsRecentTab, Mode=OneWay}"
                                 Click="NavRecent_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Circular History Icon -->
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.67"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M3.555 13.383C4.25989 14.8086 5.40339 15.9705 6.8175 16.698C8.22125 17.4192 9.82199 17.6626 11.3767 17.3913C12.9361 17.1169 14.3648 16.3451 15.4492 15.1913C16.5433 14.0264 17.24 12.5446 17.4392 10.9588C17.6411 9.36946 17.3366 7.75689 16.5692 6.35051C15.8087 4.95483 14.6201 3.84036 13.1783 3.17134C11.7464 2.50815 10.1372 2.33026 8.595 2.66468C7.05333 2.99884 5.79 3.75884 4.745 4.96051C4.61917 5.09384 4.1325 5.63218 3.72833 6.44468M6.25 6.66634L3.2425 7.26634L2.5 4.16634M10 7.49968V10.833L12.5 12.4997"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Recent notifications"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: Overlay Position -->
                    <RadioButton Style="{StaticResource NavTabItem}"
                                 IsChecked="{Binding IsOverlayPositionTab, Mode=OneWay}"
                                 Click="NavOverlayPosition_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Overlay / Layers Icon -->
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M2 4.5C2 3.83696 2.26339 3.20107 2.73223 2.73223C3.20107 2.26339 3.83696 2 4.5 2H10.5C11.163 2 11.7989 2.26339 12.2678 2.73223C12.7366 3.20107 13 3.83696 13 4.5V6H9.5C8.57174 6 7.6815 6.36875 7.02513 7.02513C6.36875 7.6815 6 8.57174 6 9.5V13H4.5C3.83696 13 3.20107 12.7366 2.73223 12.2678C2.26339 11.7989 2 11.163 2 10.5V4.5ZM9.5 7C8.83696 7 8.20107 7.26339 7.73223 7.73223C7.26339 8.20107 7 8.83696 7 9.5V15.5C7 16.163 7.26339 16.7989 7.73223 17.2678C8.20107 17.7366 8.83696 18 9.5 18H15.5C16.163 18 16.7989 17.7366 17.2678 17.2678C17.7366 16.7989 18 16.163 18 15.5V9.5C18 8.83696 17.7366 8.20107 17.2678 7.73223C16.7989 7.26339 16.163 7 15.5 7H9.5ZM8 9.5C8 9.10218 8.15804 8.72064 8.43934 8.43934C8.72064 8.15804 9.10218 8 9.5 8H15.5C15.8978 8 16.2794 8.15804 16.5607 8.43934C16.842 8.72064 17 9.10218 17 9.5V15.5C17 15.8978 16.842 16.2794 16.5607 16.5607C16.2794 16.842 15.8978 17 15.5 17H9.5C9.10218 17 8.72064 16.842 8.43934 16.5607C8.15804 16.2794 8 15.8978 8 15.5V9.5Z"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Overlay position"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: Filters -->
                    <RadioButton Style="{StaticResource NavTabItem}"
                                 IsChecked="{Binding IsFiltersTab, Mode=OneWay}"
                                 Click="NavFilters_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Filters Icon -->
                            <Path Width="18" Height="18"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Data="M16 3C16.2652 3 16.5196 3.10536 16.7071 3.29289C16.8946 3.48043 17 3.73478 17 4V16C17 16.2652 16.8946 16.5196 16.7071 16.7071C16.5196 16.8946 16.2652 17 16 17H4C3.73478 17 3.48043 16.8946 3.29289 16.7071C3.10536 16.5196 3 16.2652 3 16V4C3 3.73478 3.10536 3.48043 3.29289 3.29289C3.48043 3.10536 3.73478 3 4 3H16ZM4 2C3.46957 2 2.96086 2.21071 2.58579 2.58579C2.21071 2.96086 2 3.46957 2 4L2 16C2 16.5304 2.21071 17.0391 2.58579 17.4142C2.96086 17.7893 3.46957 18 4 18H16C16.5304 18 17.0391 17.7893 17.4142 17.4142C17.7893 17.0391 18 16.5304 18 16V4C18 3.46957 17.7893 2.96086 17.4142 2.58579C17.0391 2.21071 16.5304 2 16 2H4Z M8 13.5C8 13.3674 8.05268 13.2402 8.14645 13.1464C8.24021 13.0527 8.36739 13 8.5 13H11.5C11.6326 13 11.7598 13.0527 11.8536 13.1464C11.9473 13.2402 12 13.3674 12 13.5C12 13.6326 11.9473 13.7598 11.8536 13.8536C11.7598 13.9473 11.6326 14 11.5 14H8.5C8.36739 14 8.24021 13.9473 8.14645 13.8536C8.05268 13.7598 8 13.6326 8 13.5ZM6 10.5C6 10.3674 6.05268 10.2402 6.14645 10.1464C6.24021 10.0527 6.36739 10 6.5 10H13.5C13.6326 10 13.7598 10.0527 13.8536 10.1464C13.9473 10.2402 14 10.3674 14 10.5C14 10.6326 13.9473 10.7598 13.8536 10.8536C13.7598 10.9473 13.6326 11 13.5 11H6.5C6.36739 11 6.24021 10.9473 6.14645 10.8536C6.05268 10.7598 6 10.6326 6 10.5ZM4 7.5C4 7.36739 4.05268 7.24021 4.14645 7.14645C4.24021 7.05268 4.36739 7 4.5 7H15.5C15.6326 7 15.7598 7.05268 15.8536 7.14645C15.9473 7.24021 16 7.36739 16 7.5C16 7.63261 15.9473 7.75979 15.8536 7.85355C15.7598 7.94732 15.6326 8 15.5 8H4.5C4.36739 8 4.24021 7.94732 4.14645 7.85355C4.05268 7.75979 4 7.63261 4 7.5Z"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="Filters"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="24,20,8,20">
            <Grid>

                <!-- VIEW 1: Recent Notifications -->
                <DockPanel LastChildFill="True"
                           Visibility="{Binding IsRecentTab, Converter={StaticResource BoolToVis}}">

                    <TextBlock DockPanel.Dock="Top"
                               Text="Recent notifications"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,16,12" />

                    <!-- Bottom Controls: History Limit + Open overlay + Clear all -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Info Icon -->
                        <Border Width="16"
                                Height="16"
                                Background="#EFF6FF"
                                BorderBrush="#BFDBFE"
                                BorderThickness="1"
                                CornerRadius="8"
                                ToolTipService.InitialShowDelay="400"
                                ToolTip="Local history from this app session. Cards open URLs first, then app rules, then the source app. Click any card to jump!">
                            <TextBlock Text="i"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#2563EB"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="History limit"
                                   FontSize="12"
                                   Foreground="#475569"
                                   VerticalAlignment="Center" />

                        <TextBox Grid.Column="4"
                                 Text="{Binding Settings.HistoryLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 MinHeight="28"
                                 Height="28"
                                 Padding="4,2"
                                 TextAlignment="Center" />

                        <Button Grid.Column="6"
                                Content="Open overlay"
                                Style="{StaticResource SubtleButton}"
                                Click="ShowRecent_Click" />

                        <Button Grid.Column="8"
                                Content="Clear all"
                                Style="{StaticResource DangerButton}"
                                Click="ClearAll_Click" />
                    </Grid>

                    <!-- Scrollable History List -->
                    <ListBox ItemsSource="{Binding History}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource {x:Type ScrollBar}}" />
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,24,8" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        ToolTip="Click to open link / application"
                                        MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: App Icon + App Name + Time Text -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding AppIconUri}"
                                                       Width="32"
                                                       Height="32"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding AppIconUri, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <TextBlock Text="{Binding AppName}"
                                                           Foreground="#2563EB"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeText}"
                                                       Foreground="#94A3B8"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Row 1: Content Area (Avatar on Left, Title + Body + Image on Right) -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Circular Avatar (44x44, radius 22, clipped to circle) -->
                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="22"
                                                    Background="#E2E8F0"
                                                    Margin="0,1,12,0"
                                                    VerticalAlignment="Top"
                                                    Visibility="{Binding AvatarUri, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Border.Clip>
                                                    <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                                                </Border.Clip>
                                                <Image Source="{Binding AvatarUri}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Right Column: Title + Body + Image -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Body (2 lines preview if HasImage, else up to 90px) -->
                                                <TextBlock Text="{Binding Body}"
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           LineHeight="18">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="MaxHeight" Value="90" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                    <Setter Property="MaxHeight" Value="36" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Content Image (Width ~1/2 card, bottom gradient fade) -->
                                                <Border Width="180"
                                                        Height="105"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        CornerRadius="8"
                                                        Background="#EEF2F7"
                                                        Visibility="{Binding ImageUri, Converter={StaticResource NullToVisibilityConverter}}">
                                                    <Border.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FF000000" Offset="0.0" />
                                                            <GradientStop Color="#FF000000" Offset="0.7" />
                                                            <GradientStop Color="#00000000" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.OpacityMask>
                                                    <Border.Clip>
                                                        <RectangleGeometry Rect="0,0,180,105" RadiusX="8" RadiusY="8" />
                                                    </Border.Clip>
                                                    <Image Source="{Binding ImageUri}"
                                                           Stretch="UniformToFill"
                                                           VerticalAlignment="Top"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </DockPanel>

                <!-- VIEW 2: Overlay Position -->
                <StackPanel Visibility="{Binding IsOverlayPositionTab, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0" MaxWidth="440" HorizontalAlignment="Left">

                    <TextBlock Text="Overlay position" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Choose where notifications appear and how far they sit from the screen edge."
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,16" />

                    <!-- Anchor 2x2 Grid -->
                    <TextBlock Text="Anchor" Style="{StaticResource FieldLabel}" />
                    <ListBox ItemsSource="{Binding AnchorOptions}"
                             SelectedValue="{Binding Settings.Anchor}"
                             SelectedValuePath="Value"
                             BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource AnchorSelectorItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Screen & Auto-hide Row -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Screen" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ScreenOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Index"
                                      SelectedValue="{Binding Settings.ScreenIndex}"
                                      IsEnabled="{Binding HasMultipleScreens}"
                                      Style="{StaticResource ModernComboBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Auto-hide seconds" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Settings.AutoHideSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Offset Row -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Horizontal offset" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Settings.OffsetX, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vertical offset" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Settings.OffsetY, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>

                </StackPanel>

                <!-- VIEW 3: Filters -->
                <StackPanel Visibility="{Binding IsFiltersTab, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">

                    <TextBlock Text="Filters" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Comma-separated, case-insensitive partial matches against app name or AUMID."
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,16" />

                    <!-- Mode -->
                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding FilterModeOptions}"
                              SelectedItem="{Binding Settings.FilterMode}"
                              Style="{StaticResource ModernComboBox}" />

                    <!-- Patterns (Expanded width & comfortable height) -->
                    <TextBlock Text="Patterns" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             MinHeight="110"
                             Height="110"
                             Padding="10,8"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Example: Phone Link, Slack, Microsoft Teams" />

                    <!-- Filter Note -->
                    <TextBlock Text="Example: Phone Link, Slack. Blacklist hides matches; Whitelist shows only matches."
                               Style="{StaticResource CaptionText}"
                               Margin="0,10,0,0" />

                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
